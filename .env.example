# Copie este arquivo para ".env" (cp .env.example .env) e preencha as chaves.
# NUNCA faça commit do arquivo ".env" com chaves reais.

# Chave gratuita da OpenWeatherMap (https://openweathermap.org/api).
# Se ficar em branco ou for inválida, o Agente Coletor usa automaticamente
# dados simulados (MOCK) específicos por cidade, sem quebrar o fluxo.
OWM_API_KEY=

# Opcional. Chave da OpenAI para geração de mensagens via LLM real (gpt-4o-mini).
# Se ausente, o Agente Comunicador usa os templates de fallback (TEMPLATES em
# comunicador.py), que também são personalizados por evento e produto.
OPENAI_API_KEY=
